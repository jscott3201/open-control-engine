model InitMixturesOffGridPilot
  "Simulated from t = 0.25 s, off the 1 s sample grid, a copy of InitMixturesPilot: Mixed cones at t = 0: an initialisation pulse with a sample, a level or a Pre, into OnCounter, Latch and Toggle (issue #800, review of GitHub #805)"
  Modelica.Blocks.Sources.CombiTimeTable inputs(
    table=[0, 1; 9, 1],
    smoothness=Modelica.Blocks.Types.Smoothness.ConstantSegments,
    extrapolation=Modelica.Blocks.Types.Extrapolation.HoldLastPoint)
    "Column: x1, true throughout: Change(x1) pulses only at initialisation (pre_u_start = false)";
  Modelica.Blocks.Math.RealToBoolean x1B(threshold=0.5);
  Buildings.Controls.OBC.CDL.Logical.Sources.Constant fal(k=false);
  Buildings.Controls.OBC.CDL.Logical.Sources.Constant tru(k=true);
  Buildings.Controls.OBC.CDL.Logical.Change cha "initialisation pulse at the start";
  Buildings.Controls.OBC.CDL.Logical.Not notCha;
  Buildings.Controls.OBC.CDL.Logical.Sources.SampleTrigger s1(period=1);
  Buildings.Controls.OBC.CDL.Logical.Or orChaSam "Or(Change(x1), SampleTrigger)";
  Buildings.Controls.OBC.CDL.Logical.And andNotSam "And(Not(Change(x1)), SampleTrigger)";
  Buildings.Controls.OBC.CDL.Logical.Xor xorChaSam "Xor(Change(x1), SampleTrigger)";
  Buildings.Controls.OBC.CDL.Logical.Or orNotTru "Or(Not(Change(x1)), true)";
  Buildings.Controls.OBC.CDL.Logical.Or orNotFal "Or(Not(Change(x1)), false)";
  Buildings.Controls.OBC.CDL.Logical.Pre pre1 "a fallback leaf";
  Buildings.Controls.OBC.CDL.Logical.Or orNotPre "Or(Not(Change(x1)), Pre(false)): a fallback cone";
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntChaSam(y_start=0);
  Buildings.Controls.OBC.CDL.Logical.Latch latChaSam;
  Buildings.Controls.OBC.CDL.Logical.Toggle togChaSam;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntNotSam(y_start=0);
  Buildings.Controls.OBC.CDL.Logical.Latch latNotSam;
  Buildings.Controls.OBC.CDL.Logical.Toggle togNotSam;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntXorSam(y_start=0);
  Buildings.Controls.OBC.CDL.Logical.Latch latXorSam;
  Buildings.Controls.OBC.CDL.Logical.Toggle togXorSam;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntNotTru(y_start=0);
  Buildings.Controls.OBC.CDL.Logical.Latch latNotTru;
  Buildings.Controls.OBC.CDL.Logical.Toggle togNotTru;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntNotFal(y_start=0);
  Buildings.Controls.OBC.CDL.Logical.Latch latNotFal;
  Buildings.Controls.OBC.CDL.Logical.Toggle togNotFal;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntNotPre(y_start=0);
  Buildings.Controls.OBC.CDL.Logical.Latch latNotPre;
  Buildings.Controls.OBC.CDL.Logical.Toggle togNotPre;
  Buildings.Controls.OBC.CDL.Logical.Sources.SampleTrigger s2(period=2);
  Buildings.Controls.OBC.CDL.Logical.Not notS1;
  Buildings.Controls.OBC.CDL.Logical.Not notS2;
  Buildings.Controls.OBC.CDL.Logical.And andNotNot "And(Not(Change(x1)), Not(SampleTrigger(1 s)))";
  Buildings.Controls.OBC.CDL.Logical.And andChaNotS2 "And(Change(x1), Not(SampleTrigger(2 s)))";
  Buildings.Controls.OBC.CDL.Logical.Or orAndS1 "Or(And(Change(x1), Not(SampleTrigger(2 s))), SampleTrigger(1 s))";
  Buildings.Controls.OBC.CDL.Logical.Xor xorNotS1 "Xor(Not(Change(x1)), SampleTrigger(1 s))";
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntNotNot(y_start=0);
  Buildings.Controls.OBC.CDL.Logical.Latch latNotNot;
  Buildings.Controls.OBC.CDL.Logical.Toggle togNotNot;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntThree(y_start=0);
  Buildings.Controls.OBC.CDL.Logical.Latch latThree;
  Buildings.Controls.OBC.CDL.Logical.Toggle togThree;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntXorNot(y_start=0);
  Buildings.Controls.OBC.CDL.Logical.Latch latXorNot;
  Buildings.Controls.OBC.CDL.Logical.Toggle togXorNot;
equation
  connect(inputs.y[1], x1B.u);
  connect(x1B.y, cha.u);
  connect(cha.y, notCha.u);
  connect(cha.y, orChaSam.u1);
  connect(s1.y, orChaSam.u2);
  connect(notCha.y, andNotSam.u1);
  connect(s1.y, andNotSam.u2);
  connect(cha.y, xorChaSam.u1);
  connect(s1.y, xorChaSam.u2);
  connect(notCha.y, orNotTru.u1);
  connect(tru.y, orNotTru.u2);
  connect(notCha.y, orNotFal.u1);
  connect(fal.y, orNotFal.u2);
  connect(fal.y, pre1.u);
  connect(notCha.y, orNotPre.u1);
  connect(pre1.y, orNotPre.u2);
  connect(orChaSam.y, cntChaSam.trigger);
  connect(fal.y, cntChaSam.reset);
  connect(orChaSam.y, latChaSam.u);
  connect(fal.y, latChaSam.clr);
  connect(orChaSam.y, togChaSam.u);
  connect(fal.y, togChaSam.clr);
  connect(andNotSam.y, cntNotSam.trigger);
  connect(fal.y, cntNotSam.reset);
  connect(andNotSam.y, latNotSam.u);
  connect(fal.y, latNotSam.clr);
  connect(andNotSam.y, togNotSam.u);
  connect(fal.y, togNotSam.clr);
  connect(xorChaSam.y, cntXorSam.trigger);
  connect(fal.y, cntXorSam.reset);
  connect(xorChaSam.y, latXorSam.u);
  connect(fal.y, latXorSam.clr);
  connect(xorChaSam.y, togXorSam.u);
  connect(fal.y, togXorSam.clr);
  connect(orNotTru.y, cntNotTru.trigger);
  connect(fal.y, cntNotTru.reset);
  connect(orNotTru.y, latNotTru.u);
  connect(fal.y, latNotTru.clr);
  connect(orNotTru.y, togNotTru.u);
  connect(fal.y, togNotTru.clr);
  connect(orNotFal.y, cntNotFal.trigger);
  connect(fal.y, cntNotFal.reset);
  connect(orNotFal.y, latNotFal.u);
  connect(fal.y, latNotFal.clr);
  connect(orNotFal.y, togNotFal.u);
  connect(fal.y, togNotFal.clr);
  connect(orNotPre.y, cntNotPre.trigger);
  connect(fal.y, cntNotPre.reset);
  connect(orNotPre.y, latNotPre.u);
  connect(fal.y, latNotPre.clr);
  connect(orNotPre.y, togNotPre.u);
  connect(fal.y, togNotPre.clr);
  connect(s1.y, notS1.u);
  connect(s2.y, notS2.u);
  connect(notCha.y, andNotNot.u1);
  connect(notS1.y, andNotNot.u2);
  connect(cha.y, andChaNotS2.u1);
  connect(notS2.y, andChaNotS2.u2);
  connect(andChaNotS2.y, orAndS1.u1);
  connect(s1.y, orAndS1.u2);
  connect(notCha.y, xorNotS1.u1);
  connect(s1.y, xorNotS1.u2);
  connect(andNotNot.y, cntNotNot.trigger);
  connect(fal.y, cntNotNot.reset);
  connect(andNotNot.y, latNotNot.u);
  connect(fal.y, latNotNot.clr);
  connect(andNotNot.y, togNotNot.u);
  connect(fal.y, togNotNot.clr);
  connect(orAndS1.y, cntThree.trigger);
  connect(fal.y, cntThree.reset);
  connect(orAndS1.y, latThree.u);
  connect(fal.y, latThree.clr);
  connect(orAndS1.y, togThree.u);
  connect(fal.y, togThree.clr);
  connect(xorNotS1.y, cntXorNot.trigger);
  connect(fal.y, cntXorNot.reset);
  connect(xorNotS1.y, latXorNot.u);
  connect(fal.y, latXorNot.clr);
  connect(xorNotS1.y, togXorNot.u);
  connect(fal.y, togXorNot.clr);
end InitMixturesOffGridPilot;
