model InitNegatedOffGridPilot
  "Simulated from t = 0.25 s, off the 1 s sample grid, a copy of InitNegatedPilot: Negated initialisation pulses at t = 0: Not(Change(x)) and Not(Edge(x)) with x(0) true and false, and Not(SampleTrigger(1 s)), into every event consumer (issue #800, review of GitHub #805)"
  Modelica.Blocks.Sources.CombiTimeTable inputs(
    table=[
      0, 1, 0, 2.5;
      1, 1, 0, -3.5;
      2, 1, 0, 4.25;
      3, 0, 1, -5.5;
      4, 0, 1, 6.75;
      5, 0, 1, -7.25;
      6, 1, 0, 8.5;
      7, 1, 0, -9.75;
      8, 1, 0, 10.5;
      9, 1, 0, -11.25],
    smoothness=Modelica.Blocks.Types.Smoothness.ConstantSegments,
    extrapolation=Modelica.Blocks.Types.Extrapolation.HoldLastPoint)
    "Columns: x1 (true from the start; falls at 3 s, rises at 6 s), x0 (false from the start; rises at 3 s, falls at 6 s), uR";
  Modelica.Blocks.Math.RealToBoolean x1B(threshold=0.5);
  Modelica.Blocks.Math.RealToBoolean x0B(threshold=0.5);
  Buildings.Controls.OBC.CDL.Logical.Sources.Constant fal(k=false);
  Buildings.Controls.OBC.CDL.Logical.Sources.Constant tru(k=true);
  Buildings.Controls.OBC.CDL.Reals.Sources.Constant zer(k=0);
  Buildings.Controls.OBC.CDL.Reals.Sources.Constant one(k=1);
  Buildings.Controls.OBC.CDL.Logical.Change cha1;
  Buildings.Controls.OBC.CDL.Logical.Not notCha1;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntC1(y_start=0);
  Buildings.Controls.OBC.CDL.Discrete.TriggeredSampler samC1(y_start=7);
  Buildings.Controls.OBC.CDL.Logical.Latch latC1;
  Buildings.Controls.OBC.CDL.Logical.Toggle togC1;
  Buildings.Controls.OBC.CDL.Discrete.TriggeredMax maxC1;
  Buildings.Controls.OBC.CDL.Discrete.TriggeredMovingMean meanC1(n=3);
  Buildings.Controls.OBC.CDL.Reals.IntegratorWithReset integC1(k=1, y_start=0.5);
  Buildings.Controls.OBC.CDL.Reals.PIDWithReset pidC1(controllerType=Buildings.Controls.OBC.CDL.Types.SimpleController.PI, k=1, Ti=1e20, xi_start=0.125, y_reset=0.5, yMax=10, yMin=-10);
  Buildings.Controls.OBC.CDL.Logical.TimerAccumulating timC1(t=100);
  Buildings.Controls.OBC.CDL.Logical.Edge edg1;
  Buildings.Controls.OBC.CDL.Logical.Not notEdg1;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntE1(y_start=0);
  Buildings.Controls.OBC.CDL.Discrete.TriggeredSampler samE1(y_start=7);
  Buildings.Controls.OBC.CDL.Logical.Latch latE1;
  Buildings.Controls.OBC.CDL.Logical.Toggle togE1;
  Buildings.Controls.OBC.CDL.Logical.Change cha0;
  Buildings.Controls.OBC.CDL.Logical.Not notCha0;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntC0(y_start=0);
  Buildings.Controls.OBC.CDL.Discrete.TriggeredSampler samC0(y_start=7);
  Buildings.Controls.OBC.CDL.Logical.Latch latC0;
  Buildings.Controls.OBC.CDL.Logical.Toggle togC0;
  Buildings.Controls.OBC.CDL.Discrete.TriggeredMax maxC0;
  Buildings.Controls.OBC.CDL.Discrete.TriggeredMovingMean meanC0(n=3);
  Buildings.Controls.OBC.CDL.Reals.IntegratorWithReset integC0(k=1, y_start=0.5);
  Buildings.Controls.OBC.CDL.Reals.PIDWithReset pidC0(controllerType=Buildings.Controls.OBC.CDL.Types.SimpleController.PI, k=1, Ti=1e20, xi_start=0.125, y_reset=0.5, yMax=10, yMin=-10);
  Buildings.Controls.OBC.CDL.Logical.TimerAccumulating timC0(t=100);
  Buildings.Controls.OBC.CDL.Logical.Edge edg0;
  Buildings.Controls.OBC.CDL.Logical.Not notEdg0;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntE0(y_start=0);
  Buildings.Controls.OBC.CDL.Discrete.TriggeredSampler samE0(y_start=7);
  Buildings.Controls.OBC.CDL.Logical.Latch latE0;
  Buildings.Controls.OBC.CDL.Logical.Toggle togE0;
  Buildings.Controls.OBC.CDL.Logical.Sources.SampleTrigger s1(period=1);
  Buildings.Controls.OBC.CDL.Logical.Not notS1;
  Buildings.Controls.OBC.CDL.Integers.OnCounter cntS(y_start=0);
  Buildings.Controls.OBC.CDL.Discrete.TriggeredSampler samS(y_start=7);
  Buildings.Controls.OBC.CDL.Logical.Latch latS;
  Buildings.Controls.OBC.CDL.Logical.Toggle togS;
  Buildings.Controls.OBC.CDL.Discrete.TriggeredMax maxS;
  Buildings.Controls.OBC.CDL.Discrete.TriggeredMovingMean meanS(n=3);
  Buildings.Controls.OBC.CDL.Reals.IntegratorWithReset integS(k=1, y_start=0.5);
  Buildings.Controls.OBC.CDL.Reals.PIDWithReset pidS(controllerType=Buildings.Controls.OBC.CDL.Types.SimpleController.PI, k=1, Ti=1e20, xi_start=0.125, y_reset=0.5, yMax=10, yMin=-10);
  Buildings.Controls.OBC.CDL.Logical.TimerAccumulating timS(t=100);
equation
  connect(inputs.y[1], x1B.u);
  connect(inputs.y[2], x0B.u);
  connect(x1B.y, cha1.u);
  connect(cha1.y, notCha1.u);
  connect(notCha1.y, cntC1.trigger);
  connect(fal.y, cntC1.reset);
  connect(inputs.y[3], samC1.u);
  connect(notCha1.y, samC1.trigger);
  connect(notCha1.y, latC1.u);
  connect(fal.y, latC1.clr);
  connect(notCha1.y, togC1.u);
  connect(fal.y, togC1.clr);
  connect(inputs.y[3], maxC1.u);
  connect(notCha1.y, maxC1.trigger);
  connect(inputs.y[3], meanC1.u);
  connect(notCha1.y, meanC1.trigger);
  connect(zer.y, integC1.u);
  connect(inputs.y[3], integC1.y_reset_in);
  connect(notCha1.y, integC1.trigger);
  connect(one.y, pidC1.u_s);
  connect(inputs.y[3], pidC1.u_m);
  connect(notCha1.y, pidC1.trigger);
  connect(tru.y, timC1.u);
  connect(notCha1.y, timC1.reset);
  connect(x1B.y, edg1.u);
  connect(edg1.y, notEdg1.u);
  connect(notEdg1.y, cntE1.trigger);
  connect(fal.y, cntE1.reset);
  connect(inputs.y[3], samE1.u);
  connect(notEdg1.y, samE1.trigger);
  connect(notEdg1.y, latE1.u);
  connect(fal.y, latE1.clr);
  connect(notEdg1.y, togE1.u);
  connect(fal.y, togE1.clr);
  connect(x0B.y, cha0.u);
  connect(cha0.y, notCha0.u);
  connect(notCha0.y, cntC0.trigger);
  connect(fal.y, cntC0.reset);
  connect(inputs.y[3], samC0.u);
  connect(notCha0.y, samC0.trigger);
  connect(notCha0.y, latC0.u);
  connect(fal.y, latC0.clr);
  connect(notCha0.y, togC0.u);
  connect(fal.y, togC0.clr);
  connect(inputs.y[3], maxC0.u);
  connect(notCha0.y, maxC0.trigger);
  connect(inputs.y[3], meanC0.u);
  connect(notCha0.y, meanC0.trigger);
  connect(zer.y, integC0.u);
  connect(inputs.y[3], integC0.y_reset_in);
  connect(notCha0.y, integC0.trigger);
  connect(one.y, pidC0.u_s);
  connect(inputs.y[3], pidC0.u_m);
  connect(notCha0.y, pidC0.trigger);
  connect(tru.y, timC0.u);
  connect(notCha0.y, timC0.reset);
  connect(x0B.y, edg0.u);
  connect(edg0.y, notEdg0.u);
  connect(notEdg0.y, cntE0.trigger);
  connect(fal.y, cntE0.reset);
  connect(inputs.y[3], samE0.u);
  connect(notEdg0.y, samE0.trigger);
  connect(notEdg0.y, latE0.u);
  connect(fal.y, latE0.clr);
  connect(notEdg0.y, togE0.u);
  connect(fal.y, togE0.clr);
  connect(s1.y, notS1.u);
  connect(notS1.y, cntS.trigger);
  connect(fal.y, cntS.reset);
  connect(inputs.y[3], samS.u);
  connect(notS1.y, samS.trigger);
  connect(notS1.y, latS.u);
  connect(fal.y, latS.clr);
  connect(notS1.y, togS.u);
  connect(fal.y, togS.clr);
  connect(inputs.y[3], maxS.u);
  connect(notS1.y, maxS.trigger);
  connect(inputs.y[3], meanS.u);
  connect(notS1.y, meanS.trigger);
  connect(zer.y, integS.u);
  connect(inputs.y[3], integS.y_reset_in);
  connect(notS1.y, integS.trigger);
  connect(one.y, pidS.u_s);
  connect(inputs.y[3], pidS.u_m);
  connect(notS1.y, pidS.trigger);
  connect(tru.y, timS.u);
  connect(notS1.y, timS.reset);
end InitNegatedOffGridPilot;
