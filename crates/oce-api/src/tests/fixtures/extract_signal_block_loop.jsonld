{
  "@context": { "S231": "http://data.ashrae.org/S231P#" },
  "@graph": [
    {
      "@id": "http://example.org#ext",
      "@type": "S231:Block",
      "S231:containsBlock": [
        { "@id": "http://example.org#ext.sel" },
        { "@id": "http://example.org#ext.gai" }
      ],
      "S231:hasInput": { "@id": "http://example.org#ext.u" },
      "S231:hasOutput": { "@id": "http://example.org#ext.y" }
    },
    {
      "@id": "http://example.org#ext.u",
      "@type": "S231:RealInput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#ext.sel.u1" }
    },
    {
      "@id": "http://example.org#ext.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" }
    },
    {
      "@id": "http://example.org#ext.sel",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Routing.RealExtractSignal",
      "S231:hasParameter": [
        { "@id": "http://example.org#ext.sel.nin" },
        { "@id": "http://example.org#ext.sel.nout" }
      ],
      "S231:hasInput": [
        { "@id": "http://example.org#ext.sel.u1" },
        { "@id": "http://example.org#ext.sel.u2" }
      ],
      "S231:hasOutput": [
        { "@id": "http://example.org#ext.sel.y1" },
        { "@id": "http://example.org#ext.sel.y2" }
      ]
    },
    {
      "@id": "http://example.org#ext.sel.nin",
      "@type": "S231:Parameter",
      "S231:isOfDataType": { "@id": "S231:Integer" },
      "S231:value": 2
    },
    {
      "@id": "http://example.org#ext.sel.nout",
      "@type": "S231:Parameter",
      "S231:isOfDataType": { "@id": "S231:Integer" },
      "S231:value": 2
    },
    {
      "@id": "http://example.org#ext.sel.u1",
      "@type": "S231:RealInput",
      "S231:isOfDataType": { "@id": "S231:Real" }
    },
    {
      "@id": "http://example.org#ext.sel.u2",
      "@type": "S231:RealInput",
      "S231:isOfDataType": { "@id": "S231:Real" }
    },
    {
      "@id": "http://example.org#ext.sel.y1",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#ext.gai.u" }
    },
    {
      "@id": "http://example.org#ext.sel.y2",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#ext.y" }
    },
    {
      "@id": "http://example.org#ext.gai",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Reals.MultiplyByParameter",
      "S231:hasParameter": { "@id": "http://example.org#ext.gai.k" },
      "S231:hasInput": { "@id": "http://example.org#ext.gai.u" },
      "S231:hasOutput": { "@id": "http://example.org#ext.gai.y" }
    },
    {
      "@id": "http://example.org#ext.gai.k",
      "@type": "S231:Parameter",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:value": { "@value": "0.5", "@type": "http://www.w3.org/2001/XMLSchema#double" }
    },
    {
      "@id": "http://example.org#ext.gai.u",
      "@type": "S231:RealInput",
      "S231:isOfDataType": { "@id": "S231:Real" }
    },
    {
