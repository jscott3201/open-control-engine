# Dehumidification override, sheet revision B.
sequence ahu_dehum_override
derived_from none

param phiHigh : Real = 0.7
param phiLow : Real = 0.65

in phiRet : Real @unit 1
out dehumOn : Boolean

block dehum = CDL.Reals.Hysteresis(uLow = phiLow, uHigh = phiHigh)

phiRet -> dehum.u
dehum.y -> dehumOn
