        "name": {
          "description": "The instance name, an identifier.",
          "type": "string"
        },
        "params": {
          "description": "Parameter assignments, in authored order; an array parameter is one assignment per\nelement, named by the catalog template (\"k_1\", \"K_1_2\").",
          "items": {
            "$ref": "#/$defs/Assignment"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "class",
        "params"
      ],
      "type": "object"
    },
    "Boundary": {
      "additionalProperties": false,
      "description": "A boundary input or output.",
      "properties": {
        "display_unit": {
          "description": "The CXF display unit (for example \"degC\"), or \"\".",
          "type": "string"
        },
        "name": {
          "description": "The connector name, an identifier.",
          "type": "string"
        },
        "quantity": {
          "description": "The CXF quantity (for example \"ThermodynamicTemperature\"), or \"\".",
          "type": "string"
        },
        "semantic": {
          "$ref": "#/$defs/SemanticPoint",
          "description": "The semantic slot; every field optional (\"\" or [] or false when absent)."
        },
        "type": {
          "$ref": "#/$defs/SignalType",
          "description": "The connector type."
        }
      },
      "required": [
        "name",
        "type",
        "quantity",
        "display_unit",
        "semantic"
      ],
      "type": "object"
    },
    "EnumMember": {
      "additionalProperties": false,
      "description": "An enumeration member.",
      "properties": {
        "member": {
          "description": "The member as \"Type.Member\", Type the last segment of the enumeration class (for example\n\"SimpleController.PI\").",
          "type": "string"
        }
      },
      "required": [
        "member"
      ],
      "type": "object"
    },
    "LiteralValue": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/EnumMember"
        }
      ],
      "description": "A sequence parameter value: a number (an Integer is written without a fraction or exponent), a boolean, a string, or an enumeration member."
    },
    "ParameterValue": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Reference"
        },
        {
          "$ref": "#/$defs/EnumMember"
        }
      ],
      "description": "A block parameter value: a number (an Integer is written without a fraction or exponent), a boolean, a string (always text), a reference to a sequence parameter, or an enumeration member."
    },
    "Reference": {
      "additionalProperties": false,
      "description": "A reference to a sequence-level parameter.",
      "properties": {
        "ref": {
          "description": "The sequence parameter's name.",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "SemanticPoint": {
      "additionalProperties": false,
      "description": "The semantic slot of a boundary connector. Checked for syntax only; only `unit` reaches the\nengine.",
      "properties": {
        "brick": {
          "description": "A Brick class, or \"\".",
          "type": "string"
        },
        "haystack": {
          "description": "Haystack tags.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label": {
          "description": "A label, or \"\".",
          "type": "string"
        },
        "name": {
          "description": "A display name, or \"\".",
          "type": "string"
        },
        "provisional": {
          "description": "Whether the slot is a placeholder still to be filled.",
          "type": "boolean"
        },
        "qudt": {
          "description": "A QUDT quantity kind, or \"\".",
          "type": "string"
        },
        "s223": {
          "description": "An ASHRAE 223P class, or \"\".",
          "type": "string"
        },
        "unit": {
          "description": "The unit (for example \"K\"), or \"\".",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "unit",
        "brick",
        "s223",
        "qudt",
        "haystack",
        "provisional"
      ],
      "type": "object"
    },
    "SequenceParameter": {
      "additionalProperties": false,
      "description": "A sequence-level parameter.",
      "properties": {
        "name": {
          "description": "The parameter name, an identifier.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SignalType",
          "description": "The parameter type."
        },
        "value": {
          "$ref": "#/$defs/LiteralValue",
          "description": "The value: a number (an Integer is written without a fraction or exponent), a boolean, a\nstring or an enumeration member."
        }
      },
      "required": [
        "name",
        "type",
        "value"
      ],
      "type": "object"
    },
    "SignalType": {
      "description": "The type of a sequence parameter or a boundary connector.",
      "enum": [
        "Real",
        "Integer",
        "Boolean"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One authored sequence: a flat, single-root control sequence of boundary connectors, leaf\nblocks from the Open Control Engine catalog and the connections between them.",
  "properties": {
    "blocks": {
      "description": "Leaf blocks, in authored order.",
      "items": {
        "$ref": "#/$defs/Block"
      },
      "type": "array"
    },
    "connections": {
      "description": "Connections, each \"source -> target\"; an endpoint is a boundary name or \"block.port\".",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "extends": {
      "description": "The provenance id this sequence derives from (`<format>:<id>`), or \"\" for none.",
      "type": "string"
    },
    "inputs": {
      "description": "Boundary inputs, in authored order.",
      "items": {
        "$ref": "#/$defs/Boundary"
      },
      "type": "array"
    },
    "outputs": {
      "description": "Boundary outputs, in authored order.",
      "items": {
        "$ref": "#/$defs/Boundary"
      },
      "type": "array"
    },
    "params": {
      "description": "Sequence-level parameters, in authored order; block parameters may reference them.",
      "items": {
        "$ref": "#/$defs/SequenceParameter"
      },
      "type": "array"
    },
    "sequence": {
      "description": "The sequence name: an identifier (`[A-Za-z_][A-Za-z0-9_]*`, at most 64 bytes).",
      "type": "string"
    }
  },
  "required": [
    "sequence",
    "extends",
    "params",
    "inputs",
    "outputs",
    "blocks",
    "connections"
  ],
  "title": "Sequence",
  "type": "object"
}
