{
  "$defs": {
    "Assignment": {
      "additionalProperties": false,
      "description": "One block parameter assignment.",
      "properties": {
        "name": {
          "description": "The catalog parameter name, or an array element name.",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ParameterValue",
          "description": "The value."
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
