{
  "@context": {
    "S231": "http://data.ashrae.org/S231P#",
    "base": "http://example.org#"
  },
  "@graph": [
    {
      "@id": "http://example.org#NumericUnitLiteral",
      "@type": "S231:Block",
      "S231:containsBlock": { "@id": "http://example.org#NumericUnitLiteral.con" },
      "S231:hasOutput": { "@id": "http://example.org#NumericUnitLiteral.yNum" }
    },
    {
      "@id": "http://example.org#NumericUnitLiteral.con",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Reals.Sources.Constant",
      "S231:hasParameter": { "@id": "http://example.org#NumericUnitLiteral.con.k" },
      "S231:hasOutput": { "@id": "http://example.org#NumericUnitLiteral.con.y" }
    },
    { "@id": "http://example.org#NumericUnitLiteral.con.k",
      "S231:value": { "@value": "1.0", "@type": "http://www.w3.org/2001/XMLSchema#double" } },

    { "@id": "http://example.org#NumericUnitLiteral.con.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#NumericUnitLiteral.yNum" } },

    { "@id": "http://example.org#NumericUnitLiteral.yNum",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:unit": 5 }
  ]
}
