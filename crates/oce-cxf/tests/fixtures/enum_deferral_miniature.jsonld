{
  "@context": {
    "S231": "http://data.ashrae.org/S231P#",
    "base": "http://example.org#"
  },
  "@graph": [
    {
      "@id": "http://example.org#Mini",
      "@type": "S231:Block",
      "S231:label": "Mini",
      "S231:containsBlock": [
        { "@id": "http://example.org#Mini.con" },
        { "@id": "http://example.org#Mini.cons" },
        { "@id": "http://example.org#Mini.src" },
        { "@id": "http://example.org#Mini.gain" }
      ],
      "S231:hasInput": { "@id": "http://example.org#Mini.bIn" },
      "S231:hasOutput": { "@id": "http://example.org#Mini.yOut" }
    },

    {
      "@id": "http://example.org#Mini.con",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Reals.PID",
      "S231:label": "con",
      "S231:hasParameter": [
        { "@id": "http://example.org#Mini.con.controllerType" },
        { "@id": "http://example.org#Mini.con.k" },
        { "@id": "http://example.org#Mini.con.Ti" }
      ],
      "S231:hasInput": [
        { "@id": "http://example.org#Mini.con.u_s" },
        { "@id": "http://example.org#Mini.con.u_m" }
      ],
      "S231:hasOutput": { "@id": "http://example.org#Mini.con.y" }
    },
    { "@id": "http://example.org#Mini.con.controllerType",
      "@type": "S231:Parameter",
      "S231:isOfDataType": { "@id": "http://example.org#Buildings.Controls.OBC.CDL.Types.SimpleController" },
      "S231:value": "Buildings.Controls.OBC.CDL.Types.SimpleController.PI" },
    { "@id": "http://example.org#Mini.con.k",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:value": { "@value": "1.0", "@type": "http://www.w3.org/2001/XMLSchema#double" } },
    { "@id": "http://example.org#Mini.con.Ti",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:unit": "s",
      "S231:quantity": "Time",
      "S231:value": { "@value": "300.0", "@type": "http://www.w3.org/2001/XMLSchema#double" } },
    { "@id": "http://example.org#Mini.con.u_s", "@type": "S231:RealInput", "S231:isOfDataType": { "@id": "S231:Real" } },
    { "@id": "http://example.org#Mini.con.u_m", "@type": "S231:RealInput", "S231:isOfDataType": { "@id": "S231:Real" } },
    { "@id": "http://example.org#Mini.con.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#Mini.cons.u1" } },

    {
      "@id": "http://example.org#Mini.cons",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Reals.Add",
      "S231:label": "cons",
      "S231:hasInput": [
        { "@id": "http://example.org#Mini.cons.u1" },
        { "@id": "http://example.org#Mini.cons.u2" }
      ],
      "S231:hasOutput": { "@id": "http://example.org#Mini.cons.y" }
    },
    { "@id": "http://example.org#Mini.cons.u1", "@type": "S231:RealInput", "S231:isOfDataType": { "@id": "S231:Real" } },
    { "@id": "http://example.org#Mini.cons.u2", "@type": "S231:RealInput", "S231:isOfDataType": { "@id": "S231:Real" } },
    { "@id": "http://example.org#Mini.cons.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" } },

    {
      "@id": "http://example.org#Mini.src",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Reals.Sources.Constant",
      "S231:label": "src",
      "S231:hasParameter": { "@id": "http://example.org#Mini.src.k" },
      "S231:hasOutput": { "@id": "http://example.org#Mini.src.y" }
    },
    { "@id": "http://example.org#Mini.src.k",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:value": { "@value": "2.0", "@type": "http://www.w3.org/2001/XMLSchema#double" } },
    { "@id": "http://example.org#Mini.src.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": [
        { "@id": "http://example.org#Mini.gain.u" },
        { "@id": "http://example.org#Mini.cons.u2" },
        { "@id": "http://example.org#Mini.con.u_m" }
      ] },

    {
      "@id": "http://example.org#Mini.gain",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Reals.MultiplyByParameter",
      "S231:label": "gain",
      "S231:hasParameter": { "@id": "http://example.org#Mini.gain.k" },
      "S231:hasInput": { "@id": "http://example.org#Mini.gain.u" },
      "S231:hasOutput": { "@id": "http://example.org#Mini.gain.y" }
    },
    { "@id": "http://example.org#Mini.gain.k",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:value": { "@value": "0.5", "@type": "http://www.w3.org/2001/XMLSchema#double" } },
    { "@id": "http://example.org#Mini.gain.u", "@type": "S231:RealInput", "S231:isOfDataType": { "@id": "S231:Real" } },
    { "@id": "http://example.org#Mini.gain.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#Mini.yOut" } },

    { "@id": "http://example.org#Mini.bIn",
      "@type": "S231:RealInput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#Mini.con.u_s" } },
    { "@id": "http://example.org#Mini.yOut",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" } }
  ]
}
