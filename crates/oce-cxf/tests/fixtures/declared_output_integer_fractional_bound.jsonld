      "S231:containsBlock": { "@id": "http://example.org#IntegerFractionalBound.con" },
      "S231:hasOutput": { "@id": "http://example.org#IntegerFractionalBound.yInt" }
    },
    {
      "@id": "http://example.org#IntegerFractionalBound.con",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Integers.Sources.Constant",
