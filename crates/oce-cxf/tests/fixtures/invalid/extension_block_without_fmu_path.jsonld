{
  "@context": {
    "S231": "http://data.ashrae.org/S231#"
  },
  "@graph": [
    {
      "@id": "http://example.org#Fdd",
      "@type": "S231:Block",
      "S231:label": "Fdd",
      "S231:containsBlock": [
        { "@id": "http://example.org#Fdd.con" },
        { "@id": "http://example.org#Fdd.ext" }
      ],
      "S231:hasOutput": { "@id": "http://example.org#Fdd.yOut" }
    },

    {
      "@id": "http://example.org#Fdd.con",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Reals.Sources.Constant",
      "S231:label": "con",
      "S231:hasParameter": { "@id": "http://example.org#Fdd.con.k" },
      "S231:hasOutput": { "@id": "http://example.org#Fdd.con.y" }
    },
    { "@id": "http://example.org#Fdd.con.k",
      "S231:value": { "@value": "2.0", "@type": "http://www.w3.org/2001/XMLSchema#double" } },
    { "@id": "http://example.org#Fdd.con.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#Fdd.ext.u" } },

    {
      "@id": "http://example.org#Fdd.ext",
      "@type": "S231:ExtensionBlock",
      "S231:label": "ext",
      "S231:hasInput": { "@id": "http://example.org#Fdd.ext.u" },
      "S231:hasOutput": { "@id": "http://example.org#Fdd.ext.y" }
    },
    { "@id": "http://example.org#Fdd.ext.u",
      "@type": "S231:RealInput",
      "S231:isOfDataType": { "@id": "S231:Real" } },
    { "@id": "http://example.org#Fdd.ext.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#Fdd.yOut" } },

    { "@id": "http://example.org#Fdd.yOut",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" } }
  ]
}
