{
  "@context": {
    "S231": "http://data.ashrae.org/S231P#",
    "base": "http://example.org#"
  },
  "@graph": [
    {
      "@id": "http://example.org#Bad",
      "@type": "S231:Block",
      "S231:label": "Bad",
      "S231:containsBlock": [
        { "@id": "http://example.org#Bad.con1" },
        { "@id": "http://example.org#Bad.con2" },
        { "@id": "http://example.org#Bad.add" }
      ],
      "S231:hasInput": { "@id": "http://example.org#Bad.uIn" },
      "S231:hasOutput": { "@id": "http://example.org#Bad.yOut" }
    },

    {
      "@id": "http://example.org#Bad.con1",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Reals.Sources.Constant",
      "S231:label": "con1",
      "S231:hasParameter": { "@id": "http://example.org#Bad.con1.k" },
      "S231:hasOutput": { "@id": "http://example.org#Bad.con1.y" }
    },
    { "@id": "http://example.org#Bad.con1.k",
      "S231:value": { "@value": "1.0", "@type": "http://www.w3.org/2001/XMLSchema#double" } },
    { "@id": "http://example.org#Bad.con1.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#Bad.add.u1" } },

    {
      "@id": "http://example.org#Bad.con2",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Reals.Sources.Constant",
      "S231:label": "con2",
      "S231:hasParameter": { "@id": "http://example.org#Bad.con2.k" },
      "S231:hasOutput": { "@id": "http://example.org#Bad.con2.y" }
    },
    { "@id": "http://example.org#Bad.con2.k",
      "S231:value": { "@value": "2.0", "@type": "http://www.w3.org/2001/XMLSchema#double" } },
    { "@id": "http://example.org#Bad.con2.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#Bad.add.u1" } },

    {
      "@id": "http://example.org#Bad.add",
      "@type": "http://example.org#Buildings.Controls.OBC.CDL.Reals.Add",
      "S231:label": "add",
      "S231:hasInput": [
        { "@id": "http://example.org#Bad.add.u1" },
        { "@id": "http://example.org#Bad.add.u2" }
      ],
      "S231:hasOutput": { "@id": "http://example.org#Bad.add.y" }
    },
    { "@id": "http://example.org#Bad.add.u1", "@type": "S231:RealInput", "S231:isOfDataType": { "@id": "S231:Real" } },
    { "@id": "http://example.org#Bad.add.u2", "@type": "S231:RealInput", "S231:isOfDataType": { "@id": "S231:Real" } },
    { "@id": "http://example.org#Bad.add.y",
      "@type": "S231:RealOutput",
      "S231:isOfDataType": { "@id": "S231:Real" },
      "S231:isConnectedTo": { "@id": "http://example.org#Bad.yOut" } },

    { "@id": "http://example.org#Bad.uIn",
      "@type": "S231:RealInput",
