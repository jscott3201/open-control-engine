#!/usr/bin/env bash
# open-control fast pre-commit gate — mirrors the cheap PR->development CI.
# Heavy checks (clippy, the default-no-db tree) run in .githooks/pre-push and CI.
# Skip once:    git commit --no-verify
# Skip session: export OCE_SKIP_HOOKS=1
set -euo pipefail
[ -n "${OCE_SKIP_HOOKS:-}" ] && { echo "[pre-commit] skipped (OCE_SKIP_HOOKS)"; exit 0; }
cd "$(git rev-parse --show-toplevel)"

if [ -f Cargo.toml ]; then
  echo "[pre-commit] cargo fmt --all --check"
  cargo fmt --all --check
else
  echo "[pre-commit] (no Cargo.toml yet — skipping cargo fmt)"
fi

echo "[pre-commit] file-size cap (700 LOC)"
bash .github/scripts/check-file-size.sh

echo "[pre-commit] no-secret scan"
bash .github/scripts/check-no-secrets.sh

echo "[pre-commit] ok"
