# --- Machine-local agent identity (Aionforge Memory) — never commit ---
claude-id.json
codex-id.json
*-id.json

# --- Rust ---
/target
**/target
*.rs.bk
*.pdb

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Working / scratch folders (underscore-prefixed) — never commit ---
# _spec, _research, _scratch, _briefs, _design, etc. are local working areas.
# The durable record of decisions/research lives in Aionforge Memory.
_*/
**/_*/

# --- macOS / editors ---
.DS_Store
*.swp
*~
.idea/
.vscode/

# --- Claude Code local worktrees (agent scratch) — never commit ---
.claude/worktrees/

# --- Agent-orchestration notes — never commit ---
# This repo is public, so `.agents/` is a whitelist: everything there is local unless
# named below. Publishing is the deliberate act, which is the safe direction to fail —
# a new operating note added later stays private without anyone remembering to ignore it.
.agents/*
!.agents/gate.sh
!.agents/project-facts.md
!.agents/revendor-upstream.sh
.codex/
