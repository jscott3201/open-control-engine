      "S231:icon": "coordinateSystem(extent={{-100,-100},{100,100}},preserveAspectRatio=false),graphics={Rectangle(extent={{-100,-100},{100,100}},lineColor={0,0,127},fillColor={255,255,255},fillPattern=FillPattern.Solid),Text(textString=\"TAirSup\",textColor={0,0,127},extent={{-98,88},{-70,72}}),Text(textString=\"%name\",textColor={0,0,255},extent={{-100,140},{100,100}}),Text(textString=\"TAirSupSet\",textColor={0,0,127},extent={{-98,40},{-52,20}}),Text(textString=\"uCooCoiSet\",textColor={0,0,127},extent={{-98,-22},{-38,-38}},visible=cooCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.CoolingCoil.WaterBased),Text(textString=\"uHeaCoiSet\",textColor={0,0,127},extent={{-98,-72},{-36,-88}},visible=heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased),Text(textString=\"yChiWatResReq\",textColor={255,127,0},extent={{34,92},{98,70}},visible=cooCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.CoolingCoil.WaterBased),Text(textString=\"yChiPlaReq\",textColor={255,127,0},extent={{52,42},{98,20}},visible=cooCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.CoolingCoil.WaterBased),Text(textString=\"yHotWatResReq\",textColor={255,127,0},extent={{34,-18},{98,-40}},visible=heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased),Text(textString=\"yHotWatPlaReq\",textColor={255,127,0},extent={{38,-66},{98,-88}},visible=heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased)}",
      "S231:label": "PlantRequests"
    },
