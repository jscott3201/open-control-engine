          "@id": "ex:Buildings.Controls.OBC.ASHRAE.G36.ThermalZones.ZoneStates.uHigh"
        },
        {
          "@id": "ex:Buildings.Controls.OBC.ASHRAE.G36.ThermalZones.ZoneStates.uLow"
        }
      ],
      "S231:icon": "coordinateSystem(preserveAspectRatio=false),graphics={Rectangle(extent={{-100,-100},{100,100}},lineColor={0,0,127},fillColor={255,255,255},fillPattern=FillPattern.Solid),Text(textString=\"%name\",textColor={0,0,255},extent={{-150,150},{150,110}})}",
      "S231:label": "ZoneStates"
    },
