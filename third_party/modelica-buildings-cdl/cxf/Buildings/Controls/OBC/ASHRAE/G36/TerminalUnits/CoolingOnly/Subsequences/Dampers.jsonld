      "S231:icon": "coordinateSystem(extent={{-100,-200},{100,200}}),graphics={Rectangle(extent={{-100,-200},{100,200}},lineColor={0,0,127},fillColor={255,255,255},fillPattern=FillPattern.Solid),Text(textString=\"%name\",textColor={0,0,255},extent={{-100,240},{100,200}}),Text(textString=\"VActCooMax_flow\",textColor={0,0,127},extent={{-98,66},{-52,54}}),Text(textString=\"uZonSta\",textColor={255,127,0},extent={{-98,6},{-68,-6}}),Text(textString=\"VActMin_flow\",textColor={0,0,127},extent={{-98,186},{-54,174}}),Text(textString=\"uCoo\",textColor={0,0,127},extent={{-100,96},{-74,84}}),Text(textString=\"VDis_flow\",textColor={0,0,127},extent={{-98,-132},{-62,-146}}),Text(textString=\"TSup\",textColor={0,0,127},extent={{-100,156},{-76,146}}),Text(textString=\"TZon\",textColor={0,0,127},extent={{-100,126},{-78,116}}),Text(textString=\"yDam\",textColor={0,0,127},horizontalAlignment=TextAlignment.Right,extent={{68,-84},{96,-94}}),Line(color={95,95,95},points={{-50,64},{-50,-48},{62,-48}}),Line(color={215,215,215},points={{-2,-22},{-2,-48}},pattern=LinePattern.Dash),Polygon(points={{-64,-58},{-42,-52},{-42,-64},{-64,-58}},lineColor={95,95,95},fillColor={95,95,95},fillPattern=FillPattern.Solid),Line(color={95,95,95},points={{-2,-58},{-60,-58}}),Line(color={95,95,95},points={{16,-58},{78,-58}}),Polygon(points={{80,-58},{58,-52},{58,-64},{80,-58}},lineColor={95,95,95},fillColor={95,95,95},fillPattern=FillPattern.Solid),Text(textString=\"VSet_flow\",textColor={0,0,127},horizontalAlignment=TextAlignment.Right,extent={{60,98},{98,86}}),Line(color={0,0,255},thickness=0.5,points={{-50,-20},{-2,-20},{18,-20},{64,40}}),Text(textString=\"oveFloSet\",textColor={255,127,0},extent={{-100,-84},{-56,-96}}),Text(textString=\"oveDamPos\",textColor={255,127,0},extent={{-96,-172},{-52,-184}}),Text(textString=\"u1Fan\",textColor={255,0,255},extent={{-98,-34},{-68,-46}})}",
