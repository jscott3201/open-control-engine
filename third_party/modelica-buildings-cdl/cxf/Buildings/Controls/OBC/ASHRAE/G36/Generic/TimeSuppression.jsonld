        }
      ],
      "S231:icon": "coordinateSystem(extent={{-100,-100},{100,100}},preserveAspectRatio=false),graphics={Rectangle(extent={{-100,-100},{100,100}},lineColor={0,0,127},fillColor={255,255,255},fillPattern=FillPattern.Solid),Text(textString=\"%name\",textColor={0,0,255},extent={{-100,140},{100,100}}),Text(textString=\"TSet\",textColor={0,0,127},extent={{-100,48},{-62,30}}),Text(textString=\"yAftSup\",textColor={255,0,255},extent={{52,12},{96,-8}}),Text(textString=\"TZon\",textColor={0,0,127},extent={{-100,-30},{-62,-48}})}",
