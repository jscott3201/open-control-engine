    {
      "@id": "ex:Buildings.Controls.OBC.ASHRAE.G36.Generic.TimeSuppression.maxTim",
      "@type": "S231:Parameter",
      "S231:accessSpecifier": "public",
      "S231:description": "Maximum suppression time. For cooling or heating request, it should be 1800 seconds, for temperature alarms, it should be 7200 seconds",
      "S231:isOfDataType": {
        "@id": "S231:Real"
      },
      "S231:label": "maxTim",
      "S231:value": 1800,
      "qudt:hasQuantityKind": {
        "@id": "q:Time"
      },
      "qudt:hasUnit": {
        "@id": "unit:SEC"
      }
    },
    {
      "@id": "ex:Buildings.Controls.OBC.ASHRAE.G36.Generic.TimeSuppression.pasSup",
      "@type": "ex:Buildings.Controls.OBC.CDL.Reals.Greater",
      "S231:accessSpecifier": "protected",
      "S231:description": "Check if the change has been suppressed by sufficient time",
      "S231:graphics": "Placement(transformation(extent={{20,-160},{40,-140}})))",
      "S231:hasInstance": [
        {
          "@id": "ex:Buildings.Controls.OBC.ASHRAE.G36.Generic.TimeSuppression.pasSup.u1"
