      "S231:icon": "coordinateSystem(extent={{-100,-100},{100,100}}),graphics={Rectangle(extent={{-100,100},{100,-100}},lineColor={0,0,0},fillColor={255,255,255},fillPattern=FillPattern.Solid),Text(textString=\"%name\",textColor={0,0,255},extent={{-100,140},{100,100}}),Text(textString=\"VSumZonAbsMin_flow\",textColor={0,0,0},extent={{-98,88},{-26,72}}),Text(textString=\"VSumZonDesMin_flow\",textColor={0,0,0},extent={{-96,38},{-26,22}}),Text(textString=\"VEffAbsOutAir_flow\",textColor={0,0,0},extent={{26,88},{98,72}}),Text(textString=\"VEffDesOutAir_flow\",textColor={0,0,0},extent={{26,10},{98,-6}}),Text(textString=\"effAbsOutAir_normalized\",textColor={0,0,0},extent={{6,52},{96,30}}),Text(textString=\"effDesOutAir_normalized\",textColor={0,0,0},extent={{6,-28},{96,-50}}),Text(textString=\"uCO2Loo_max\",textColor={0,0,0},extent={{-96,-24},{-46,-38}},visible=have_CO2Sen),Text(textString=\"effOutAir_normalized\",textColor={0,0,0},extent={{18,-48},{96,-70}}),Text(textString=\"outAir_normalized\",textColor={0,0,0},extent={{30,-76},{96,-100}},visible=(minOADes == Buildings.Controls.OBC.ASHRAE.G36.Types.OutdoorAirSection.DedicatedDampersAirflow or minOADes == Buildings.Controls.OBC.ASHRAE.G36.Types.OutdoorAirSection.SingleDamper)),Text(textString=\"VAirOut_flow\",textColor={0,0,0},extent={{-98,-74},{-54,-88}},visible=(minOADes == Buildings.Controls.OBC.ASHRAE.G36.Types.OutdoorAirSection.DedicatedDampersAirflow or minOADes == Buildings.Controls.OBC.ASHRAE.G36.Types.OutdoorAirSection.SingleDamper))}",
